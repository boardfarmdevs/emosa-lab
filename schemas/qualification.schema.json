{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "pod_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "database": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "connection": {
      "type": "object",
      "properties": {
        "direction": {
          "enum": [
            "dial",
            "listen"
          ]
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "trust": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "mutual-tls",
                "local-unix",
                "existing-tunnel"
              ]
            },
            "peer_certificate_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "certificate_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            "private_key_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            "ca_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            "evidence_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "direction",
        "endpoint",
        "trust"
      ],
      "additionalProperties": false
    },
    "secret_directory": {
      "type": "string",
      "minLength": 1
    },
    "read_only": {
      "const": true
    },
    "timeout_seconds": {
      "type": "number",
      "minimum": 1,
      "maximum": 60
    },
    "expected_identifiers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "pod_id",
    "database",
    "connection",
    "secret_directory",
    "read_only"
  ],
  "additionalProperties": false
}
