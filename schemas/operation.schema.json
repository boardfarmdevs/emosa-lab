{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "request_source": {
      "type": "string",
      "minLength": 1
    },
    "initiating_interface": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "pod_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "radio_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "bss_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "ssid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "secret_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            "enabled": {
              "type": "boolean"
            },
            "security_mode": {
              "enum": [
                "wpa2-psk",
                "wpa3-sae"
              ]
            },
            "additional": {
              "type": "array",
              "maxItems": 7,
              "items": {
                "type": "object",
                "properties": {
                  "role": {
                    "enum": [
                      "fronthaul",
                      "backhaul"
                    ]
                  },
                  "ssid": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  },
                  "secret_ref": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
                  }
                },
                "required": [
                  "role",
                  "ssid",
                  "secret_ref"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "pod_id",
            "radio_id",
            "bss_id",
            "ssid",
            "secret_ref"
          ],
          "additionalProperties": false,
          "title": "Configure a BSS (the fronthaul scope)"
        },
        {
          "title": "Move the pod's backhaul station onto the EasyMesh backhaul (the uplink scope, data plane option 1)",
          "type": "object",
          "properties": {
            "pod_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "station": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,15}$"
            },
            "ssid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "secret_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            "mode": {
              "enum": [
                "multi-ap"
              ]
            },
            "bssid": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$",
              "description": "The upstream backhaul BSS; required for a switch, absent in records made before it existed"
            }
          },
          "required": [
            "pod_id",
            "station",
            "ssid",
            "secret_ref",
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "title": "Have the pod publish its own statistics (the telemetry scope)",
          "type": "object",
          "properties": {
            "pod_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "broker": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "topic": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "radio_type": {
              "enum": [
                "2.4G",
                "5G",
                "5GL",
                "5GU",
                "6G"
              ]
            },
            "reporting_interval": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "sampling_interval": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "publish_interval": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          },
          "required": [
            "pod_id",
            "broker",
            "port",
            "topic",
            "radio_type",
            "reporting_interval",
            "sampling_interval"
          ],
          "additionalProperties": false
        },
        {
          "title": "Steer one station from a BSS of the pod to a target BSS (the steering scope)",
          "type": "object",
          "properties": {
            "pod_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "station": {
              "type": "string",
              "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$"
            },
            "source_bssid": {
              "type": "string",
              "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$"
            },
            "target_bssid": {
              "type": "string",
              "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$"
            },
            "op_class": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            },
            "channel": {
              "type": "integer",
              "minimum": 1,
              "maximum": 233
            },
            "disassoc_imminent": {
              "type": "boolean"
            },
            "window": {
              "type": "integer",
              "minimum": 5,
              "maximum": 120
            },
            "request_mid": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          "required": [
            "pod_id",
            "station",
            "source_bssid",
            "target_bssid",
            "op_class",
            "channel",
            "disassoc_imminent",
            "window",
            "request_mid"
          ],
          "additionalProperties": false
        }
      ]
    },
    "intent_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time"
    },
    "schema_version": {
      "const": 1
    },
    "state": {
      "enum": [
        "REQUESTED",
        "VALIDATED",
        "SUBMITTED",
        "CONFIG_COMMITTED",
        "OBSERVED_APPLIED",
        "REJECTED",
        "FAILED",
        "TIMED_OUT",
        "INDETERMINATE",
        "OWNERSHIP_CONFLICT",
        "CANCELLED"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "mapping_version": {
      "type": "string",
      "minLength": 1
    },
    "schema_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attempt_id": {
            "type": "string",
            "minLength": 1
          },
          "transaction_id": {
            "type": "string",
            "minLength": 1
          },
          "session_generation": {
            "type": "integer",
            "minimum": 1
          },
          "prepared_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "attempt_id",
          "transaction_id",
          "session_generation",
          "prepared_at"
        ],
        "additionalProperties": false
      }
    },
    "commit_evidence": {
      "type": "object",
      "required": [
        "attribution"
      ],
      "properties": {
        "attribution": {
          "enum": [
            "not_submitted",
            "unknown",
            "reply"
          ]
        }
      }
    },
    "application_predicate": {
      "type": "string",
      "minLength": 1
    },
    "application_evidence": {
      "type": [
        "object",
        "null"
      ]
    },
    "changed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "deadline_elapsed": {
      "type": "boolean"
    },
    "original_outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "late_resolution": {
      "type": [
        "string",
        "null"
      ]
    },
    "client_verification": {
      "type": "object",
      "required": [
        "verdict"
      ]
    },
    "blocked_for_resubmission": {
      "type": "boolean"
    },
    "plan": {
      "type": [
        "object",
        "null"
      ]
    },
    "timings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "seconds_since_request": {
            "type": "number",
            "minimum": 0
          },
          "process_clock_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "seconds_since_request",
          "process_clock_id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "operation_id",
    "run_id",
    "request_source",
    "initiating_interface",
    "intent",
    "intent_fingerprint",
    "idempotency_key",
    "created_at",
    "updated_at",
    "deadline_at",
    "schema_version",
    "state",
    "reason",
    "mapping_version",
    "schema_fingerprint",
    "attempts",
    "commit_evidence",
    "application_predicate",
    "application_evidence",
    "changed",
    "deadline_elapsed",
    "original_outcome",
    "late_resolution",
    "client_verification",
    "blocked_for_resubmission",
    "plan",
    "timings"
  ],
  "additionalProperties": false
}
