{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "request_source": {
      "type": "string",
      "minLength": 1
    },
    "initiating_interface": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "pod_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "radio_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "bss_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "ssid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "secret_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            "enabled": {
              "type": "boolean"
            },
            "security_mode": {
              "enum": [
                "wpa2-psk",
                "wpa3-sae"
              ]
            },
            "additional": {
              "type": "array",
              "maxItems": 7,
              "items": {
                "type": "object",
                "properties": {
                  "role": {
                    "enum": [
                      "fronthaul",
                      "backhaul"
                    ]
                  },
                  "ssid": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  },
                  "secret_ref": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
                  }
                },
                "required": [
                  "role",
                  "ssid",
                  "secret_ref"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "pod_id",
            "radio_id",
            "bss_id",
            "ssid",
            "secret_ref"
          ],
          "additionalProperties": false,
          "title": "Configure a BSS (the fronthaul scope)"
        },
        {
          "title": "Configure a further radio's slot BSSes from its own M2 set (a radio scope, spec 9)",
          "type": "object",
          "properties": {
            "pod_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "radio_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "additional": {
              "description": "The BSSes of the radio's M2 set it maps onto its slots; empty: none (its slot VIFs are removed)",
              "type": "array",
              "maxItems": 7,
              "items": {
                "type": "object",
                "properties": {
                  "role": {
                    "enum": [
                      "fronthaul",
                      "backhaul"
                    ]
                  },
                  "ssid": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  },
                  "secret_ref": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
                  }
                },
                "required": [
                  "role",
                  "ssid",
                  "secret_ref"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "pod_id",
            "radio_id",
            "additional"
          ],
          "additionalProperties": false
        },
        {
          "title": "Move the pod's backhaul station onto the EasyMesh backhaul (the uplink scope, data plane option 1)",
          "type": "object",
          "properties": {
            "pod_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "station": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,15}$"
            },
            "ssid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "secret_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            "mode": {
              "enum": [
                "multi-ap",
                "gre"
              ],
              "description": "multi-ap: a 4-address Multi-AP backhaul join (spec 8.3). gre: a 3-address join onto a fleet GRE parent's AP (spec 8.6); the credential is onboard_type=gre and bssid is required."
            },
            "bssid": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$",
              "description": "The upstream backhaul BSS; required for a switch (and always for a GRE move), absent in records made before it existed"
            }
          },
          "required": [
            "pod_id",
            "station",
            "ssid",
            "secret_ref",
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "title": "Revert the pod's backhaul station to its bootstrap (back to bootstrap, the uplink scope, spec 8.6)",
          "type": "object",
          "properties": {
            "pod_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "station": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,15}$"
            },
            "ssid": {
              "type": "string",
              "maxLength": 32
            },
            "secret_ref": {
              "type": "string",
              "maxLength": 96
            },
            "mode": {
              "const": "bootstrap",
              "description": "A revert, not a pin: EMOSA writes no credential, restores the station's snapshotted vconf columns and deletes the credential it inserted, and the pod's parent pin lands the station on the bootstrap BSS."
            },
            "bssid": {
              "type": "string",
              "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$",
              "description": "The bootstrap BSS the station lands back on."
            },
            "restore": {
              "type": "object",
              "description": "The pre-move vconf columns to put back: ssid, security, credential_configs, and multi_ap/wds if a Multi-AP move cleared them."
            }
          },
          "required": [
            "pod_id",
            "station",
            "mode",
            "bssid",
            "restore"
          ],
          "additionalProperties": false
        },
        {
          "title": "Have the pod publish its own statistics (the telemetry scope)",
          "type": "object",
          "properties": {
            "pod_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "broker": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "topic": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "radio_type": {
              "enum": [
                "2.4G",
                "5G",
                "5GL",
                "5GU",
                "6G"
              ]
            },
            "reporting_interval": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "sampling_interval": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "publish_interval": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "survey": {
              "type": "boolean"
            }
          },
          "required": [
            "pod_id",
            "broker",
            "port",
            "topic",
            "radio_type",
            "reporting_interval",
            "sampling_interval"
          ],
          "additionalProperties": false
        },
        {
          "title": "Steer one station from a BSS of the pod to a target BSS (the steering scope)",
          "type": "object",
          "properties": {
            "pod_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "station": {
              "type": "string",
              "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$"
            },
            "source_bssid": {
              "type": "string",
              "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$"
            },
            "target_bssid": {
              "type": "string",
              "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$"
            },
            "op_class": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            },
            "channel": {
              "type": "integer",
              "minimum": 1,
              "maximum": 233
            },
            "disassoc_imminent": {
              "type": "boolean"
            },
            "window": {
              "type": "integer",
              "minimum": 5,
              "maximum": 120
            },
            "request_mid": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          },
          "required": [
            "pod_id",
            "station",
            "source_bssid",
            "target_bssid",
            "op_class",
            "channel",
            "disassoc_imminent",
            "window",
            "request_mid"
          ],
          "additionalProperties": false
        },
        {
          "title": "Watch the probe requests of these stations on the pod (the probe-watch scope)",
          "type": "object",
          "properties": {
            "pod_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "if_name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,15}$"
            },
            "band": {
              "enum": [
                "2.4G",
                "5G",
                "5GL",
                "5GU"
              ]
            },
            "stations": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$"
              }
            }
          },
          "required": [
            "pod_id",
            "if_name",
            "band",
            "stations"
          ],
          "additionalProperties": false
        },
        {
          "title": "Bridge a wired pod's Ethernet uplink into its home bridge (the wired uplink scope, spec 8.4)",
          "type": "object",
          "properties": {
            "pod_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "port": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,15}$"
            },
            "bridge": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,15}$"
            }
          },
          "required": [
            "pod_id",
            "port",
            "bridge"
          ],
          "additionalProperties": false
        },
        {
          "title": "A legacy pod's station on the site's GTP BSS (the GTP station scope, spec 3.10)",
          "type": "object",
          "properties": {
            "pod_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "station": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,15}$"
            },
            "ssid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "secret_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
            },
            "bssid": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$"
            }
          },
          "required": [
            "pod_id",
            "station",
            "ssid",
            "secret_ref"
          ],
          "additionalProperties": false
        },
        {
          "title": "A legacy pod's radio plan (the radio plan scope, spec 3.10)",
          "type": "object",
          "properties": {
            "pod_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "claimed": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,15}$"
              }
            },
            "band": {
              "enum": [
                "2.4G",
                "5G",
                "6G"
              ]
            },
            "channel": {
              "type": "integer",
              "minimum": 1,
              "maximum": 233
            },
            "ht_mode": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16
            },
            "neutral_ref": {
              "description": "EMOSA's own passphrase for the unclaimed APs, by reference (absent in records made before it: emosa-unclaimed)",
              "type": "string",
              "pattern": "^emosa-[a-z0-9-]{1,32}$"
            },
            "gtp_ssid": {
              "description": "The site's GTP SSID (uplink.bootstrap): while the pod is wired, the plan deletes every station row not on it (absent: no station judged)",
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "idle_radios": {
              "description": "The radios the profile neither binds nor places: the plan turns one on at its channel and ht_mode when it carries an enabled AP while its state shows it off or with no channel (absent: none)",
              "type": "array",
              "maxItems": 2,
              "items": {
                "type": "object",
                "properties": {
                  "band": {"enum": ["5G", "6G"]},
                  "channel": {"type": "integer", "minimum": 1, "maximum": 233},
                  "ht_mode": {"type": "string", "minLength": 1, "maxLength": 16}
                },
                "required": ["band", "channel", "ht_mode"],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "pod_id",
            "claimed",
            "band",
            "channel",
            "ht_mode"
          ],
          "additionalProperties": false
        },
        {
          "title": "A GRE parent AP's tunnels, one to each child address (the GRE parent scope, spec 8.6)",
          "type": "object",
          "properties": {
            "pod_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "ap": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,15}$"
            },
            "bridge": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,15}$"
            },
            "remotes": {
              "type": "array",
              "maxItems": 241,
              "items": {
                "type": "string",
                "pattern": "^169\\.254\\.[0-9]{1,3}\\.[0-9]{1,3}$"
              }
            }
          },
          "required": [
            "pod_id",
            "ap",
            "bridge",
            "remotes"
          ],
          "additionalProperties": false
        },
        {
          "title": "Write the pod's modules' settings (the node-config scope, spec 4, the pods' modules)",
          "type": "object",
          "properties": {
            "pod_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "modules": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
              },
              "additionalProperties": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[a-z0-9][a-z0-9_]{0,63}$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              }
            }
          },
          "required": [
            "pod_id",
            "modules"
          ],
          "additionalProperties": false
        }
      ]
    },
    "intent_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time"
    },
    "schema_version": {
      "const": 1
    },
    "state": {
      "enum": [
        "REQUESTED",
        "VALIDATED",
        "SUBMITTED",
        "CONFIG_COMMITTED",
        "OBSERVED_APPLIED",
        "REJECTED",
        "FAILED",
        "TIMED_OUT",
        "INDETERMINATE",
        "OWNERSHIP_CONFLICT",
        "CANCELLED"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "mapping_version": {
      "type": "string",
      "minLength": 1
    },
    "schema_fingerprint": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attempt_id": {
            "type": "string",
            "minLength": 1
          },
          "transaction_id": {
            "type": "string",
            "minLength": 1
          },
          "session_generation": {
            "type": "integer",
            "minimum": 1
          },
          "prepared_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "attempt_id",
          "transaction_id",
          "session_generation",
          "prepared_at"
        ],
        "additionalProperties": false
      }
    },
    "commit_evidence": {
      "type": "object",
      "required": [
        "attribution"
      ],
      "properties": {
        "attribution": {
          "enum": [
            "not_submitted",
            "unknown",
            "reply"
          ]
        }
      }
    },
    "application_predicate": {
      "type": "string",
      "minLength": 1
    },
    "application_evidence": {
      "type": [
        "object",
        "null"
      ]
    },
    "changed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "deadline_elapsed": {
      "type": "boolean"
    },
    "original_outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "late_resolution": {
      "type": [
        "string",
        "null"
      ]
    },
    "client_verification": {
      "type": "object",
      "required": [
        "verdict"
      ]
    },
    "blocked_for_resubmission": {
      "type": "boolean"
    },
    "plan": {
      "type": [
        "object",
        "null"
      ]
    },
    "timings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "seconds_since_request": {
            "type": "number",
            "minimum": 0
          },
          "process_clock_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "seconds_since_request",
          "process_clock_id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "operation_id",
    "run_id",
    "request_source",
    "initiating_interface",
    "intent",
    "intent_fingerprint",
    "idempotency_key",
    "created_at",
    "updated_at",
    "deadline_at",
    "schema_version",
    "state",
    "reason",
    "mapping_version",
    "schema_fingerprint",
    "attempts",
    "commit_evidence",
    "application_predicate",
    "application_evidence",
    "changed",
    "deadline_elapsed",
    "original_outcome",
    "late_resolution",
    "client_verification",
    "blocked_for_resubmission",
    "plan",
    "timings"
  ],
  "additionalProperties": false
}
