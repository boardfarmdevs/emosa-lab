{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "process_clock_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "operation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "pod_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "sequence",
    "timestamp",
    "process_clock_id",
    "run_id",
    "operation_id",
    "pod_id",
    "phase",
    "reason",
    "payload"
  ],
  "additionalProperties": false
}
