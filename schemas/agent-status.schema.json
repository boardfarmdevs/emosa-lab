{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/boardfarmdevs/emosa-lab/schemas/agent-status.schema.json",
  "title": "EMOSA virtual agent status",
  "description": "STATE_DIR/status.json, rewritten at least once a second while anything changes. Read-only for observers; never contains secrets.",
  "type": "object",
  "required": ["pod_id", "profile", "agent_al", "controller_al", "pod", "report_source_available", "session", "operations", "writes", "worker_pid", "updated"],
  "properties": {
    "pod_id": {"type": "string"},
    "profile": {"type": "string"},
    "agent_al": {"type": "string", "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$"},
    "controller_al": {"type": "string", "pattern": "^[0-9a-f]{2}(:[0-9a-f]{2}){5}$"},
    "pod": {
      "description": "What the agent currently reports about the pod; null while the pod is unavailable.",
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["serial", "ruid", "channel", "bsses", "stations"],
          "properties": {
            "serial": {"type": "string"},
            "node_id": {"type": ["string", "null"]},
            "firmware": {"type": ["string", "null"]},
            "radio": {"type": ["string", "null"]},
            "ruid": {"type": "string"},
            "bssid": {"type": ["string", "null"]},
            "channel": {"type": "integer"},
            "ssid": {"type": ["string", "null"]},
            "bsses": {"type": "array", "items": {"type": "object", "required": ["role", "bssid", "ssid"], "properties": {"role": {"enum": ["fronthaul", "backhaul"]}, "bssid": {"type": "string"}, "ssid": {"type": "string"}}}},
            "stations": {"type": "array", "items": {"type": "string"}},
            "backhaul": {
              "description": "The pod's EasyMesh backhaul STA (option 1), as reported to the controller; null over OpenSync's GRE (option 2).",
              "oneOf": [
                {"type": "null"},
                {"type": "object", "required": ["station", "mac", "parent", "band", "channel"], "properties": {"station": {"type": "string"}, "mac": {"type": "string"}, "parent": {"type": "string"}, "band": {"type": "string"}, "channel": {"type": "integer"}}}
              ]
            },
            "ovsdb_generation": {"type": "integer"},
            "ovsdb_revision": {"type": "integer"}
          }
        }
      ]
    },
    "report_source_available": {"type": "boolean"},
    "session": {"type": ["object", "null"], "description": "The onboarding session: state, counters and recent events.", "properties": {"state": {"enum": ["waiting_source", "discovering", "admitting", "awaiting_m2", "provisioning", "source_lost", "failed", "incompatible", "closed"]}}},
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["operation_id", "state", "reason", "ssid", "attempts"],
        "properties": {
          "operation_id": {"type": "string"},
          "state": {"enum": ["REQUESTED", "VALIDATED", "SUBMITTED", "CONFIG_COMMITTED", "INDETERMINATE", "OBSERVED_APPLIED", "TIMED_OUT", "FAILED", "REJECTED", "OWNERSHIP_CONFLICT", "CANCELLED"]},
          "reason": {"type": ["string", "null"]},
          "ssid": {"type": ["string", "null"]},
          "attempts": {"type": "integer", "minimum": 0},
          "application_evidence": {"type": ["object", "null"]}
        }
      }
    },
    "uplink": {
      "description": "The uplink scope (data plane option 1). mode off: the agent leaves the pod's uplink alone.",
      "type": "object",
      "required": ["station"],
      "properties": {
        "station": {"type": ["string", "null"]},
        "mode": {"enum": ["off"]},
        "uplink": {"type": ["string", "null"], "description": "multi-ap, or the if_type of the uplink cm uses (gre, eth, vif)."},
        "in_use": {"type": ["string", "null"]},
        "bssid": {"type": ["string", "null"], "description": "The upstream backhaul BSS the station is pinned to."},
        "parent": {"type": ["string", "null"], "description": "The BSS the station is on (lower case)."},
        "option": {"enum": [1, 2]},
        "held": {"type": ["object", "null"], "description": "Held on option 2 and why; EMOSA does not switch this pod again until it is admitted anew."},
        "waiting": {"type": ["string", "null"]},
        "operation": {
          "type": ["object", "null"],
          "properties": {
            "operation_id": {"type": "string"},
            "state": {"type": "string"},
            "reason": {"type": ["string", "null"]},
            "ssid": {"type": ["string", "null"]},
            "instance": {"type": ["string", "null"]}
          }
        }
      }
    },
    "telemetry": {"description": "The telemetry scope and the pod's own statistics as measured (spec §3.6). Absent fields stay absent: nothing is filled in.", "type": "object", "required": ["mode"], "properties": {"mode": {"enum": ["off", "mqtt"]}, "waiting": {"type": ["string", "null"]}, "subscribed": {"type": "boolean"}, "operation": {"type": ["object", "null"]}, "topic": {"type": "string"}, "reports_accepted": {"type": "integer", "minimum": 0}, "reports_rejected": {"type": "integer", "minimum": 0}, "gaps": {"type": "integer", "minimum": 0}, "last_error": {"type": ["string", "null"]}, "last_report_at": {"type": ["number", "null"]}, "stations": {"type": "object", "additionalProperties": {"type": "object"}}}},
    "steering": {"description": "The client steering scope (spec §3.7): its counters, the open window and the latest outcomes.", "type": "object", "required": ["mode"], "properties": {"mode": {"enum": ["off", "owm"]}, "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "active": {"type": ["object", "null"]}, "history": {"type": "array", "items": {"type": "object"}}}},
    "writes": {"type": "integer", "minimum": 0},
    "worker_pid": {"type": "integer"},
    "updated": {"type": "number"}
  }
}
