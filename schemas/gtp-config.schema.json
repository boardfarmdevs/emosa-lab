{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/boardfarmdevs/emosa-lab/schemas/gtp-config.schema.json",
  "title": "EMOSA GRE termination point configuration",
  "description": "The gateway end of the pods' OpenSync GRE (spec section 8). The underlay must be link-local and the GTP its first host; emosa-gtp checks both.",
  "type": "object",
  "additionalProperties": false,
  "required": ["underlay", "lan", "tunnel_mtu", "state_dir"],
  "properties": {
    "underlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface", "address", "mtu", "dhcp_range", "lease_time"],
      "properties": {
        "interface": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,15}$", "description": "Where the pod-backhaul SSID lands (bridge, VLAN or AP interface)."},
        "address": {"type": "string", "pattern": "^169\\.254\\.[0-9]{1,3}\\.[0-9]{1,3}/[0-9]{1,2}$"},
        "mtu": {"type": "integer", "minimum": 1538, "maximum": 2304, "description": "Also sent to pods as DHCP option 26."},
        "dhcp_range": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "string"}], "minItems": 2, "maxItems": 2},
        "lease_time": {"type": "string", "pattern": "^([0-9]+[mh]?|infinite)$", "description": "Finite leases let the GTP remove tunnels of pods that left."}
      }
    },
    "lan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bridge", "ports"],
      "properties": {
        "bridge": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,15}$", "description": "Bridge the tunnels join; created if absent."},
        "ports": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,15}$"}, "description": "Interfaces on the gateway LAN, enslaved to the bridge."}
      }
    },
    "tunnel_mtu": {"type": "integer", "minimum": 1280, "maximum": 2266, "default": 1562},
    "state_dir": {"type": "string", "minLength": 1}
  }
}
