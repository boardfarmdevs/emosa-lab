{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emosa.local/schemas/config.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "backend_mode": {
      "enum": [
        "model",
        "ovsdb-sim",
        "opensync-native",
        "hardware"
      ]
    },
    "state_directory": {
      "type": "string",
      "minLength": 1
    },
    "secret_directory": {
      "type": "string",
      "minLength": 1
    },
    "socket_path": {
      "type": "string",
      "minLength": 1
    },
    "write_mode": {
      "enum": [
        "read-only",
        "managed-fields"
      ]
    },
    "request_source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "pods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pod_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "endpoint": {
            "type": "string",
            "minLength": 1
          },
          "database": {
            "const": "Open_vSwitch"
          },
          "if_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "radio_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "radio_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "bss_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "state_provenance": {
            "description": "Declared simulation State producer; evidence must independently verify it. Does not qualify hardware or enable wire processing.",
            "enum": [
              "independent-simulated-manager:Wifi_VIF_State",
              "independent-hostapd-nl80211-manager:Wifi_VIF_State"
            ]
          },
          "virtual_agent": {
            "type": "object",
            "properties": {
              "al_mac": {
                "type": "string",
                "pattern": "^[0-9a-f][26ae](?::[0-9a-f]{2}){5}$"
              },
              "expected_serial": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "topology": {
                "type": "object",
                "properties": {
                  "radios": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "radio_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "if_name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "ruid": {
                          "type": "string",
                          "pattern": "^[0-9a-f][26ae](?::[0-9a-f]{2}){5}$"
                        },
                        "expected_mac": {
                          "type": "string",
                          "pattern": "^[0-9a-f][02468ace](?::[0-9a-f]{2}){5}$"
                        },
                        "interfaces": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "interface_id": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                              },
                              "if_name": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                              },
                              "mode": {
                                "enum": [
                                  "ap",
                                  "sta"
                                ]
                              },
                              "expected_mac": {
                                "type": "string",
                                "pattern": "^[0-9a-f][02468ace](?::[0-9a-f]{2}){5}$"
                              }
                            },
                            "required": [
                              "interface_id",
                              "if_name",
                              "mode",
                              "expected_mac"
                            ],
                            "additionalProperties": false
                          },
                          "maxItems": 16
                        }
                      },
                      "required": [
                        "radio_id",
                        "if_name",
                        "ruid",
                        "expected_mac",
                        "interfaces"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "maxItems": 8
                  }
                },
                "required": [
                  "radios"
                ],
                "additionalProperties": false,
                "description": "Optional complete synthetic identity binding, persisted in the local journal. Read-only topology and value diagnostics; no wire or physical qualification."
              }
            },
            "required": [
              "al_mac",
              "expected_serial"
            ],
            "additionalProperties": false
          },
          "mapping_scope": {
            "enum": [
              "existing-bss",
              "sole-fronthaul-radio"
            ],
            "description": "Optional stricter synthetic radio-scope admission; never enables physical or EasyMesh writes."
          },
          "radio_capabilities": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/",
                "maxLength": 4096
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "pod_id",
          "endpoint",
          "database",
          "if_name",
          "radio_name",
          "radio_id",
          "bss_id"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32
    },
    "limits": {
      "type": "object",
      "properties": {
        "local_frame_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        },
        "local_clients": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "ovsdb_requests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "backend_mode",
    "state_directory",
    "secret_directory",
    "socket_path",
    "write_mode",
    "request_source",
    "pods"
  ],
  "additionalProperties": false
}
