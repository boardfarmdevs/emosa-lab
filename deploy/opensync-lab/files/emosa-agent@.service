[Unit]
Description=EMOSA virtual EasyMesh agent for OpenSync pod %i
After=network-online.target

[Service]
ExecStartPre=/usr/local/sbin/emosa-agent-link %i
ExecStart=/opt/emosa/.venv/bin/python -m emosa.agent.pod /etc/emosa/%i.json
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
