+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#ifndef EMOSA_AP_METRICS_ESP_H
+#define EMOSA_AP_METRICS_ESP_H
+
+#include <array>
+#include <algorithm>
+#include <tlvf/wfa_map/tlvApMetrics.h>
+
+namespace son {
+struct ApMetricEspField {
+    bool present = false;
+    std::array<uint8_t, 3> value{};
+};
+using ApMetricEspFields = std::array<ApMetricEspField, 4>;
+
+// EasyMesh 6.1 Table 45: mandatory BE, then optional BK, VO, VI.
+// This preserves the three opaque octets; it does not qualify their semantics.
+// Invalid input leaves the output unchanged and must precede BSS model updates.
+inline bool decode_ap_metric_esp(wfa_map::tlvApMetrics &tlv, ApMetricEspFields &output)
+{
+    if (!tlv.isInitialized()) {
+        return false;
+    }
+    const auto &flags = tlv.estimated_service_parameters();
+    const std::array<bool, 4> present{{bool(flags.include_ac_be), bool(flags.include_ac_bk),
+                                     bool(flags.include_ac_vo), bool(flags.include_ac_vi)}};
+    const size_t expected = 3 * std::count(present.begin(), present.end(), true);
+    if (!present[0] || tlv.estimated_service_info_field_length() != expected) {
+        return false;
+    }
+    ApMetricEspFields fields{};
+    size_t offset = 0;
+    for (size_t i = 0; i < present.size(); ++i) {
+        fields[i].present = present[i];
+        if (!present[i]) {
+            continue;
+        }
+        const auto bytes = tlv.estimated_service_info_field(offset);
+        if (!bytes) {
+            return false;
+        }
+        std::copy_n(bytes, 3, fields[i].value.begin());
+        offset += 3;
+    }
+    output = fields;
+    return true;
+}
+} // namespace son
+#endif
