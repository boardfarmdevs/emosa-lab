[Unit]
Description=EMOSA fleet: a virtual EasyMesh agent for every OpenSync pod handed to it
After=network-online.target

[Service]
EnvironmentFile=-/etc/default/emosa
ExecStart=/opt/emosa-adapter/venv/bin/emosa-fleet serve /etc/emosa-fleet.json
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
