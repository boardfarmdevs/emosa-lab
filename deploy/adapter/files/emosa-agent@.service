[Unit]
Description=EMOSA virtual EasyMesh agent for OpenSync pod %i
After=network-online.target

[Service]
EnvironmentFile=-/etc/default/emosa
ExecStartPre=/usr/local/sbin/emosa-agent-link %i
ExecStart=/opt/emosa-adapter/venv/bin/emosa-agent /etc/emosa/%i.json
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
