# EMOSA's fleet, as a distribution's package installs it (CMake EMOSA_INSTALL_DATA).
# Inert until configured: it starts once @EMOSA_FLEET_CONFIG@ exists (the example is in
# @CMAKE_INSTALL_FULL_DATADIR@/emosa; schema fleet-config). It enables and starts an
# emosa-agent@POD for each pod handed to its front port.
[Unit]
Description=EMOSA fleet: a virtual EasyMesh agent for every OpenSync pod handed to it
After=network-online.target
Wants=network-online.target
ConditionPathExists=@EMOSA_FLEET_CONFIG@

[Service]
EnvironmentFile=-/etc/default/emosa
ExecStart=@EMOSA_BINDIR@/emosa-fleet-c serve @EMOSA_FLEET_CONFIG@
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
