# EMOSA's environment (the emosa-fleet and emosa-agent@ units read it; for one pod's agent
# also /etc/default/emosa-POD).
# The agents' trunk: each agent adds a macvlan on it with its own AL MAC. On a gateway the
# trunk is a veth pair into the controller's LAN bridge (EMOSA_BRIDGE, brlan0 on RDK-B),
# created by the agents' link helper; on a host with an interface on the controller's LAN,
# name that interface and leave EMOSA_BRIDGE empty.
EMOSA_TRUNK=emlan
EMOSA_BRIDGE=brlan0
#EMOSA_BRIDGE_PORT=emlan-br
# Where the programs read their data, when not the build's places:
#EMOSA_SCHEMAS=/usr/share/emosa/schemas
#EMOSA_PROFILES=/usr/share/emosa/profiles
# Where this package's units read the configurations (the build's places), and the places a
# fleet configuration names on this platform: its config_dir EMOSA_AGENT_CONFIG_DIR, its
# state_root EMOSA_STATE_ROOT and its run_root EMOSA_RUN_ROOT (a RAM disk; none when empty).
# For tools that configure EMOSA; the programs read their configuration files.
EMOSA_FLEET_CONFIG=@EMOSA_FLEET_CONFIG@
EMOSA_AGENT_CONFIG_DIR=@EMOSA_AGENT_CONFIG_DIR@
EMOSA_GTP_CONFIG=@EMOSA_GTP_CONFIG@
EMOSA_STATE_ROOT=@EMOSA_STATE_ROOT@
EMOSA_RUN_ROOT=@EMOSA_RUN_ROOT@
